# Bun's `--compile` intermediate outputs. Normally atomic-renamed to --outfile
# on success; failed/interrupted builds leave them behind in the cwd.
.*-*.bun-build

# Generated by scripts/gen-asset-manifest.ts from the (gitignored) dist/ build —
# its content-hashed import names change on every build. Regenerated before
# `tsc -b` (see the `build` / `typecheck` scripts) so a fresh clone type-checks.
src/server/asset-manifest.ts

# Playwright MCP screenshots / snapshots / console logs from local browser-driven verification
.playwright-mcp/


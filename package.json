{
  "name": "tandem",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.2.1",
  "engines": {
    "node": ">=22.12",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n server,vite -c blue,green \"pnpm start\" \"vite\"",
    "dev:web": "concurrently -n server,vite -c blue,green \"pnpm serve\" \"vite\"",
    "build": "pnpm build:manifest && tsc -b && vite build",
    "build:manifest": "bun scripts/gen-asset-manifest.ts",
    "build:app": "bun scripts/build-app.ts",
    "clean": "bun scripts/clean.ts",
    "start": "pnpm build:manifest && bun src/server/app.ts",
    "serve": "pnpm build:manifest && bun src/server/worker.ts",
    "typecheck": "pnpm build:manifest && tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "dependencies": {
    "@pierre/diffs": "^1.3.5",
    "@pierre/trees": "1.0.0-beta.6",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@uipath/apollo-wind": "^2.36.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "webview-bun": "^2.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "bun-types": "~1.3.14",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.67.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
